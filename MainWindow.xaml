<Window x:Class="PolyhedraLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Компьютерная графика — OBJ, поверхности, Z-буфер и камера"
        Width="1280"
        Height="850"
        MinWidth="940"
        MinHeight="640">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="365" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TabControl x:Name="Panels" Margin="5" />

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="Viewport"
                    Margin="5"
                    Background="#F3F5F8"
                    ClipToBounds="True">
                <Image x:Name="Picture" Stretch="Fill" />
            </Border>

            <TextBlock x:Name="Status"
                       Grid.Row="1"
                       Margin="10"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
